{
  "name": "life-metric",
  "version": "0.1.0",
  "description": "Read LIFE extinction-risk maps into typed arrays and GeoTIFFs, or display them with MapLibre",
  "author": {
    "name": "Anil Madhavapeddy",
    "email": "anil@recoil.org",
    "url": "https://anil.recoil.org"
  },
  "contributors": [
    {
      "name": "Michael Dales",
      "email": "mwd24@cam.ac.uk"
    }
  ],
  "license": "MIT",
  "homepage": "https://source.coop/tessera/life",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantifyearth/LIFE.js.git"
  },
  "keywords": [
    "biodiversity",
    "extinction",
    "zarr",
    "raster",
    "LIFE",
    "maplibre"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./colour": {
      "types": "./dist/colour.d.ts",
      "import": "./dist/colour.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre.d.ts",
      "import": "./dist/maplibre.js"
    },
    "./geotiff": {
      "types": "./dist/geotiff.d.ts",
      "import": "./dist/geotiff.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build",
    "build:examples": "tsc -p tsconfig.examples.json",
    "example": "npm run build:examples && node dist-examples/examples/run.js"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "geotiff": "^3.0.5",
    "zarrita": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "maplibre-gl": "^6.11.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
